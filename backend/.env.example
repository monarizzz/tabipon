# Copy this file to backend/.env and replace the sample values.

# Supabase (cloud) connection used by app/clients/supabase_client.py.
# SUPABASE_KEY must be the service_role (secret) key, not the anon key,
# because the backend writes to Postgres and Storage. Never commit it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-role-key
