    "prettier": "^3.9.6",
    "test-renderer": "^1.2.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "start:tunnel:log": "mkdir -p ../log && script -q ../log/frontend.log pnpm exec expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "pnpm run setup:skia-web && expo start --web",
    "setup:skia-web": "setup-skia-web",
    "storybook:ios": "cross-env STORYBOOK_ENABLED=true expo start --ios",
    "storybook:android": "cross-env STORYBOOK_ENABLED=true expo start --android",
    "storybook:web": "pnpm run setup:skia-web && cross-env STORYBOOK_ENABLED=true expo start --web --port 6006",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "private": true
}
