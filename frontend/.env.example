# バックエンド(FastAPI)のURL
# Railway デプロイ済みバックエンドを使う場合:
# EXPO_PUBLIC_API_URL=https://progate-20266-oogishima-production.up.railway.app
#
# ローカルバックエンドを実機/Expo Go から使う場合:
# 実機/Expo Go では localhost は端末自身を指すため、PCのLAN IPを指定する
#   PCのIP確認: ipconfig getifaddr en0
# iOSシミュレータのみ http://localhost:8000 でも可
# 変更後は `npx expo start -c` でキャッシュクリア再起動が必要
EXPO_PUBLIC_API_URL=http://192.168.x.x:8000

# Supabase (匿名認証・スタンプ管理に使用)
# Supabaseダッシュボード → Project Settings → Data API / API Keys から取得
#   URL      : Project URL (例: https://xxxxxxxx.supabase.co)
#   ANON KEY : anon public キー(クライアント公開用。service_role キーは使わない)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Google Maps (スタンプ詳細画面の地図表示に使用)
# Google Cloud Console → APIとサービス → 認証情報 → APIキーを作成
# Maps JavaScript API を有効化すること
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
