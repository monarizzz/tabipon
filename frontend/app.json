{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "scheme": "stampapp",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.monarizzz.frontend"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3d9c77",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.monarizzz.frontend"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "スタンプ撮影のためにカメラへのアクセスを許可してください",
          "microphonePermission": "このアプリはマイクを使用しません",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "スタンプを取得した場所を記録するために位置情報へのアクセスを許可してください"
        }
      ],
      "expo-localization"
    ]
  }
}
